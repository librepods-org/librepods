<?xml version="1.0" encoding="utf-8"?>
<me.kavishdevar.librepods.presentation.overlays.IslandView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/island_content"
        android:layout_width="match_parent"
        android:layout_height="@dimen/island_height"
        android:layout_margin="@dimen/island_bleed"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="16dp">

        <me.kavishdevar.librepods.presentation.overlays.LoopingVideoView
            android:id="@+id/island_video_view"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/island_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/island_connected_text"
                android:textColor="@color/island_secondary_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/island_device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="16sp"
                tools:text="AirPods Pro" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="@dimen/island_battery_ring_size"
            android:layout_height="@dimen/island_battery_ring_size">

            <me.kavishdevar.librepods.presentation.overlays.BatteryRingView
                android:id="@+id/island_battery_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/island_action_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ic_undo_button_bg"
                android:contentDescription="@string/undo"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_undo"
                android:tint="@color/white"
                android:visibility="gone"
                tools:ignore="UseAppTint" />
        </FrameLayout>
    </LinearLayout>
</me.kavishdevar.librepods.presentation.overlays.IslandView>
