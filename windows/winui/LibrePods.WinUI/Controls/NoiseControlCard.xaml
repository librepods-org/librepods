<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Controls.NoiseControlCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Noise control — segmented icon buttons (Off / NC / Transparency / Adaptive).
         Single-selection is enforced in code-behind; the current mode name shows
         below the row. Off is disabled unless the daemon reports allow_off. -->
    <Border Style="{StaticResource Card}">
        <StackPanel Spacing="10">
            <TextBlock Text="{Binding [NoiseControlTitle_Text], Source={StaticResource Loc}}" Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="AncOffBtn" Grid.Column="0" Tag="1"
                              HorizontalAlignment="Stretch" Padding="0" Height="52"
                              Click="Anc_Click">
                    <FontIcon Glyph="&#xE7E8;" FontSize="22" />
                </ToggleButton>
                <ToggleButton x:Name="AncNcBtn" Grid.Column="1" Tag="2"
                              HorizontalAlignment="Stretch" Padding="0" Height="52"
                              Click="Anc_Click">
                    <FontIcon Glyph="&#xE7F6;" FontSize="22" />
                </ToggleButton>
                <ToggleButton x:Name="AncTransBtn" Grid.Column="2" Tag="3"
                              HorizontalAlignment="Stretch" Padding="0" Height="52"
                              Click="Anc_Click">
                    <FontIcon Glyph="&#xE890;" FontSize="22" />
                </ToggleButton>
                <ToggleButton x:Name="AncAdaptiveBtn" Grid.Column="3" Tag="4"
                              HorizontalAlignment="Stretch" Padding="0" Height="52"
                              Click="Anc_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="22" />
                </ToggleButton>
            </Grid>

            <TextBlock x:Name="AncModeLabel"
                       Text="—"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Border>
</UserControl>
