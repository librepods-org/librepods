<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Controls.HearingAidCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Hearing assistance (AirPods Pro 3, accessibility amplification) -->
    <Border Style="{StaticResource Card}">
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding [HearingAidTitle_Text], Source={StaticResource Loc}}"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="{Binding [HearingAidSubtitle_Text], Source={StaticResource Loc}}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       TextWrapping="Wrap" />
            <InfoBar Title="{Binding [HearingAidWarning_Title], Source={StaticResource Loc}}"
                     Message="{Binding [HearingAidWarning_Message], Source={StaticResource Loc}}"
                     Severity="Warning" IsOpen="True" IsClosable="False" />

            <ToggleSwitch x:Name="EnableSwitch"
                          OnContent="{Binding [Toggle_On], Source={StaticResource Loc}}"
                          OffContent="{Binding [Toggle_Off], Source={StaticResource Loc}}"
                          Header="{Binding [HearingAidSwitch_Header], Source={StaticResource Loc}}"
                          Toggled="Enable_Toggled" />

            <!-- Per-person audiogram (hearing loss, dB HL). Rows built in code-behind. -->
            <TextBlock Text="{Binding [HearingAidAudiogram_Header], Source={StaticResource Loc}}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0" />
            <Grid x:Name="AudiogramGrid" ColumnSpacing="10" RowSpacing="4" />

            <TextBlock Text="{Binding [HearingAidAmp_Header], Source={StaticResource Loc}}"
                       Style="{ThemeResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
            <Slider x:Name="AmpSlider" Minimum="0" Maximum="100" Value="50"
                    ValueChanged="Settings_Changed" IsEnabled="False" />

            <TextBlock Text="{Binding [HearingAidBalance_Header], Source={StaticResource Loc}}"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
            <Slider x:Name="BalanceSlider" Minimum="-100" Maximum="100" Value="0"
                    ValueChanged="Settings_Changed" IsEnabled="False" />

            <TextBlock Text="{Binding [HearingAidTone_Header], Source={StaticResource Loc}}"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
            <Slider x:Name="ToneSlider" Minimum="-100" Maximum="100" Value="0"
                    ValueChanged="Settings_Changed" IsEnabled="False" />

            <ToggleSwitch x:Name="ConvBoostSwitch"
                          OnContent="{Binding [Toggle_On], Source={StaticResource Loc}}"
                          OffContent="{Binding [Toggle_Off], Source={StaticResource Loc}}"
                          Header="{Binding [HearingAidConvBoost_Header], Source={StaticResource Loc}}"
                          IsEnabled="False"
                          Toggled="ConvBoost_Toggled" />
        </StackPanel>
    </Border>
</UserControl>
