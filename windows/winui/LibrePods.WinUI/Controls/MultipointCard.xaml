<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Controls.MultipointCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ipc="using:LibrePods.WinUI.Ipc"
    mc:Ignorable="d">

    <!-- Multipoint: the hosts the AirPods themselves report being connected to.
         Windows cannot see this at all - it only knows about its own link - so
         this card is the only place the sharing is visible. -->
    <Border Style="{StaticResource Card}">
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding [MultipointTitle_Text], Source={StaticResource Loc}}"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <TextBlock x:Name="SummaryText"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ipc:ConnectedDevice">
                        <Grid Margin="0,6,0,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="{x:Bind Glyph}"
                                      FontSize="18"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Address}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding [Multipoint_Hint], Source={StaticResource Loc}}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</UserControl>
