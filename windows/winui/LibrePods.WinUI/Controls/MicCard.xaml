<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Controls.MicCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Hi-res microphone -->
    <Border Style="{StaticResource Card}">
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding [MicTitle_Text], Source={StaticResource Loc}}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="MicStatusText"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ToggleSwitch OnContent="{Binding [Toggle_On], Source={StaticResource Loc}}" OffContent="{Binding [Toggle_Off], Source={StaticResource Loc}}" x:Name="MicAutoSwitch"
                          Header="{Binding [MicAutoSwitch_Header], Source={StaticResource Loc}}"
                          Toggled="MicAuto_Toggled" />
            <ToggleButton x:Name="MicManualToggle"
                          Content="{Binding [MicEnableBtn_Content], Source={StaticResource Loc}}"
                          Click="MicManual_Click" />
        </StackPanel>
    </Border>
</UserControl>
