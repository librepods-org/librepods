<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Controls.DeviceHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Header: AirPods image + name/status + actions, full width -->
    <Border Style="{StaticResource Card}">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image x:Name="DeviceImage"
                   Grid.Column="0"
                   Width="96" Height="96"
                   Stretch="Uniform"
                   Source="ms-appx:///Assets/airpods.png"
                   VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <!-- Name — view (with a pencil) / edit (text box + submit/cancel) -->
                <StackPanel x:Name="NameView" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="DeviceName"
                               Text="LibrePods"
                               VerticalAlignment="Center"
                               Style="{ThemeResource TitleTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="RenameBtn" Click="Rename_Click"
                            Background="Transparent" BorderThickness="0" Padding="6"
                            Visibility="Collapsed" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Rename">
                        <FontIcon Glyph="&#xE70F;" FontSize="15" />
                    </Button>
                </StackPanel>
                <StackPanel x:Name="NameEdit" Orientation="Horizontal" Spacing="6"
                            Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBox x:Name="NameBox" Width="220" MaxLength="64" KeyDown="NameBox_KeyDown" />
                    <Button x:Name="SubmitBtn" Click="Submit_Click"
                            Style="{StaticResource AccentButtonStyle}" Padding="8,4">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                    </Button>
                    <Button x:Name="CancelBtn" Click="Cancel_Click" Padding="8,4">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             Fill="{ThemeResource TextFillColorDisabledBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Text="Connecting…"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton x:Name="ConnectButton"
                                     Content="{Binding [HeaderConnectBtn_Content], Source={StaticResource Loc}}"
                                     Padding="0"
                                     Visibility="Collapsed"
                                     Click="Connect_Click" />
                </StackPanel>
            </StackPanel>

            <!-- Right-side actions: Disconnect while connected, Repair while not -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <!-- Repair connection (shown only while disconnected) — forces a
                     clean reconnect to recover a wedged / desynced link. -->
                <Button x:Name="RepairButton"
                        Click="Repair_Click"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="{Binding [HeaderRepairBtn_Text], Source={StaticResource Loc}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="{Binding [HeaderRepairBtn_Text], Source={StaticResource Loc}}" />
                    </StackPanel>
                </Button>
                <!-- Restore audio (shown only while connected) — toggles the audio
                     services without touching the AAP session. -->
                <Button x:Name="RebuildAudioButton"
                        Click="RebuildAudio_Click"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="{Binding [HeaderRebuildAudioBtn_Tip], Source={StaticResource Loc}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE767;" FontSize="14" />
                        <TextBlock Text="{Binding [HeaderRebuildAudioBtn_Text], Source={StaticResource Loc}}" />
                    </StackPanel>
                </Button>
                <!-- Disconnect (shown only while connected) -->
                <Button x:Name="DisconnectButton"
                        Click="Disconnect_Click"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8CD;" FontSize="14" />
                        <TextBlock Text="{Binding [HeaderDisconnectBtn_Text], Source={StaticResource Loc}}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Shown after a rename: the OS only reflects the new name on the
                 next connect. Title/Subtitle are set (localized) in code. -->
            <TeachingTip x:Name="RenameHint"
                         IsLightDismissEnabled="True"
                         PreferredPlacement="Bottom" />
        </Grid>
    </Border>
</UserControl>
