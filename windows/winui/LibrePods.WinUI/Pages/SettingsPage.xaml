<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LibrePods.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Text binds to the runtime {StaticResource Loc} service (not x:Uid) so the UI
         language switches live, without a restart, on the unpackaged build. Keys are
         the .resw names with the dot replaced by '_' (e.g. SettingsTitle.Text →
         [SettingsTitle_Text]) — a dot inside a binding indexer is ambiguous. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,0,24">
        <StackPanel Spacing="16"
                    Padding="24"
                    HorizontalAlignment="Stretch">

            <TextBlock Text="{Binding [SettingsTitle_Text], Source={StaticResource Loc}}"
                       Style="{ThemeResource TitleTextBlockStyle}" />

            <InfoBar x:Name="SettingsInfoBar"
                     IsOpen="False"
                     IsClosable="True" />

            <!-- Appearance -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding [SettingsAppearance_Text], Source={StaticResource Loc}}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{Binding [SettingsTheme_Text], Source={StaticResource Loc}}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <RadioButtons x:Name="ThemeButtons"
                                  MaxColumns="3"
                                  SelectedIndex="0"
                                  SelectionChanged="Theme_SelectionChanged">
                        <RadioButton Content="{Binding [ThemeSystemRadio_Content], Source={StaticResource Loc}}" />
                        <RadioButton Content="{Binding [ThemeLightRadio_Content], Source={StaticResource Loc}}" />
                        <RadioButton Content="{Binding [ThemeDarkRadio_Content], Source={StaticResource Loc}}" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- Language — live switch via the Loc service (no restart). -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding [SettingsLanguage_Text], Source={StaticResource Loc}}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{Binding [SettingsLanguageHint_Text], Source={StaticResource Loc}}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <ComboBox x:Name="LanguageCombo" MinWidth="220"
                              SelectionChanged="Language_SelectionChanged">
                        <ComboBoxItem Content="{Binding [LangSystem_Content], Source={StaticResource Loc}}" Tag="" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                        <ComboBoxItem Content="Português" Tag="pt-PT" />
                        <ComboBoxItem Content="Français" Tag="fr-FR" />
                        <ComboBoxItem Content="Español" Tag="es-ES" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Startup — run LibrePods (daemon + tray app) at Windows login. -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding [SettingsStartup_Text], Source={StaticResource Loc}}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="StartupSetting"
                                  OnContent="{Binding [Toggle_On], Source={StaticResource Loc}}"
                                  OffContent="{Binding [Toggle_Off], Source={StaticResource Loc}}"
                                  Header="{Binding [SettingsStartupToggle_Header], Source={StaticResource Loc}}"
                                  Toggled="StartupSetting_Toggled" />
                </StackPanel>
            </Border>

            <!-- Experimental — collapsed by default so it isn't immediately visible;
                 the user must expand it to reach the opt-ins. Heart rate is off by
                 default because AirPods gate the HR stream to Apple hosts; on Windows
                 it does not work. -->
            <Expander HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="{Binding [SettingsExperimental_Text], Source={StaticResource Loc}}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                </Expander.Header>
                <StackPanel Spacing="8">
                    <InfoBar Severity="Warning" IsOpen="True" IsClosable="False"
                             Title="{Binding [SettingsHrWarning_Title], Source={StaticResource Loc}}"
                             Message="{Binding [SettingsHrWarning_Message], Source={StaticResource Loc}}" />
                    <ToggleSwitch OnContent="{Binding [Toggle_On], Source={StaticResource Loc}}" OffContent="{Binding [Toggle_Off], Source={StaticResource Loc}}" x:Name="ExperimentalSetting"
                                  Header="{Binding [SettingsHrToggle_Header], Source={StaticResource Loc}}"
                                  Toggled="ExperimentalSetting_Toggled" />
                </StackPanel>
            </Expander>

            <!-- Device info — hidden behind an eye toggle + frosted blur (it carries
                 the serial number). Populated from the 0x1D metadata packet. -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [SettingsDeviceInfo_Text], Source={StaticResource Loc}}" Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <ToggleButton x:Name="RevealInfo" Grid.Column="1" Padding="8,4"
                                      Checked="RevealInfo_Toggled" Unchecked="RevealInfo_Toggled">
                            <FontIcon Glyph="&#xE7B3;" FontSize="15" />
                        </ToggleButton>
                    </Grid>

                    <!-- Model + firmware are not sensitive — always visible. -->
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [DeviceInfoModel_Text], Source={StaticResource Loc}}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ModelText" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [DeviceInfoFirmware_Text], Source={StaticResource Loc}}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="FirmwareText" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                        </Grid>
                        <!-- Serial IS sensitive — only this row sits behind the eye + blur. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [DeviceInfoSerial_Text], Source={StaticResource Loc}}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="SerialText" Text="—" TextWrapping="Wrap" />
                                <Border x:Name="InfoBlur" CornerRadius="4" Margin="-2,-1">
                                    <Border.Background>
                                        <AcrylicBrush TintOpacity="0.55"
                                                      TintLuminosityOpacity="0.9"
                                                      FallbackColor="{ThemeResource CardBackgroundFillColorDefault}" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding [SettingsAbout_Text], Source={StaticResource Loc}}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="LibrePods"
                               Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding [SettingsAppDesc_Text], Source={StaticResource Loc}}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionText"
                               Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
