# The prebuilt driver catalogs (.cat) pin the exact bytes of each INF. A CRLF
# conversion on checkout (Windows CI runners use autocrlf) changes the hash and
# the package no longer installs, so never normalise line endings there.
drivers/**/prebuilt/*.inf -text
